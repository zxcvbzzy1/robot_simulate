# Backend defaults. Restart the API after editing this file.
# Explicit process environment values override this file.

# API (host machine)
WELD_API_HOST=0.0.0.0
WELD_API_PORT=18800
WELD_SERVICE_URL=http://127.0.0.1:18800

# API -> Docker host port; this is NOT the container's internal 8801.
WELD_PLANNER_URL=http://127.0.0.1:18801
WELD_PLANNER_READY_TIMEOUT_S=15

# Docker publication and internal bridge listener
WELD_PLANNER_HOST=0.0.0.0
WELD_PLANNER_PORT=18801
WELD_BRIDGE_HOST=0.0.0.0
WELD_BRIDGE_PORT=8801
WELD_CONTAINER_NAME=fr5-weld-planner
WELD_IMAGE=fr5-weld-planner:jazzy

# Deployment paths shared between the API and the container
WELD_WORKSPACE=/home/zzy/robot_simulate/FR_Weld_Seam_Planning_ws
WELD_ARTIFACT_ROOT=/home/zzy/robot_simulate/FR_Weld_Seam_Planning_ws/output/service
ROBOT_SIMULATION_ROOT=/home/zzy/robot_simulate/FR_Weld_Seam_Planning_ws/output/service/simulations
# Optional extra server input directory; uploaded files need no extra mount.
WELD_INPUT_ROOT=

# Computation and upload limits
WELD_JOB_TIMEOUT_S=3600
WELD_UPLOAD_MAX_BYTES=536870912
MPLBACKEND=Agg

# ROS isolation inside the container
ROS_DOMAIN_ID=58
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
