      "post": {
        "tags": [
          "files"
        ],
        "summary": "Upload File",
        "description": "Upload bytes first; use the returned file_path in the existing JSON API.",
        "operationId": "upload_file_api_v1_files_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_file_api_v1_files_post"
