                "type": "null"
              }
            ],
            "title": "Camera Position Base"
          },
          "h_width_mm": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "H Width Mm"
          },
          "tube_width_mm": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Tube Width Mm"
          },
          "max_planes": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Planes",
            "default": 20
          },
          "min_seam_length_mm": {
            "type": "number",
            "minimum": 3.0,
            "title": "Min Seam Length Mm",
            "default": 3
          },
          "max_gap_mm": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Gap Mm"
          },
          "voxel_size_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Voxel Size Mm",
            "default": 1
          },
          "sample_step_mm": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Sample Step Mm",
            "default": 2
          },
          "posture_width_mm": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Posture Width Mm",
            "default": 5
          },
          "approach_distance_mm": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Approach Distance Mm",
            "default": 10
          },
          "retract_distance_mm": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Retract Distance Mm",
            "default": 10
          },
          "plane_distance_threshold_mm": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Plane Distance Threshold Mm",
            "default": 2
          },
          "ransac_iterations": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Ransac Iterations",
            "default": 100
          },
          "seed": {
            "type": "integer",
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 0
          },
          "tcp_rotation_offset_deg": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Tcp Rotation Offset Deg"
          }
