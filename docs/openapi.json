              },
              {
                "type": "null"
              }
            ],
            "title": "Seam Indices"
          },
          "min_seam_length_mm": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Min Seam Length Mm",
            "default": 3
          },
          "sample_step_mm": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Sample Step Mm",
            "default": 2
          },
          "approach_distance_mm": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Approach Distance Mm",
            "default": 10
          },
          "retract_distance_mm": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Retract Distance Mm",
            "default": 10
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stl_path",
          "unit",
          "pose_in_base"
        ],
        "title": "STLRequest"
      },
